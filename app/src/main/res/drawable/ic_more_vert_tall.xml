        android:fillColor="#FF000000"
        android:pathData="M9.8,4.5a2.2,2.2 0 1,0 4.4,0a2.2,2.2 0 1,0 -4.4,0M9.8,12a2.2,2.2 0 1,0 4.4,0a2.2,2.2 0 1,0 -4.4,0M9.8,19.5a2.2,2.2 0 1,0 4.4,0a2.2,2.2 0 1,0 -4.4,0" />
